# NVIDIA BioNeMo & NIM API Configuration
# Get your API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
ESM2_ENDPOINT=https://integrate.api.nvidia.com/v1/biology/nvidia/esm2-650m
DIFFDOCK_ENDPOINT=https://integrate.api.nvidia.com/v1/biology/nvidia/diffdock

# Set to true for full local self-hosted app without demo trial limits (client-side):
DISABLE_TRIAL_LIMIT=true
# Set to true to run offline mock mode with zero NVIDIA API credits:
USE_MOCK=true

# Admin Reset Key for hosted instances (protects /api/reset-trial from unauthorized access):
ADMIN_RESET_KEY=bionemo-admin-dev-secret
