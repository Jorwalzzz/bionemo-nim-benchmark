# NVIDIA BioNeMo & NIM Runtime Configuration
# Copy to .env for local development. Never place publishing tokens (PyPI/npm/Docker) here.

# NVIDIA API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
ESM2_ENDPOINT=https://integrate.api.nvidia.com/v1/biology/nvidia/esm2-650m
DIFFDOCK_ENDPOINT=https://integrate.api.nvidia.com/v1/biology/nvidia/diffdock

# Runtime server settings
PORT=8088
HOST=0.0.0.0

# Set to true for unrestricted local workstation mode; false enforces quotas
DISABLE_TRIAL_LIMIT=true
# Set to true for zero-credit deterministic mock inference
USE_MOCK=true

# Self-hosted / private NIM network SSRF allowlist controls
NIM_ALLOW_PRIVATE_HOSTS=false
NIM_ALLOWED_HOSTS=

# Admin reset key protecting /api/reset-trial (generate via: openssl rand -hex 32)
ADMIN_RESET_KEY=<generate-with-openssl-rand-hex-32>
